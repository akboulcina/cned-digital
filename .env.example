# MapTiler browser key: use an application-specific key and restrict its allowed origins.
MAPTILER_API_KEY=
MAPTILER_STYLE=streets-v2

# Optional alternative provider. Must use HTTPS, include {z}/{x}/{y}, and include attribution.
# Do not configure OpenStreetMap's public tile servers here.
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=Example map data
# MAP_TILE_ATTRIBUTION_URL=https://tiles.example.com/terms
